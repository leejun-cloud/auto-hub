# Vercel serverless functions require this. Value is pulled from the mvpkit key store.
OPENAI_API_KEY=

# Private GitHub 저장소 가져오기(/api/github-import)에 사용. 서버 전용 비밀값.
GITHUB_TOKEN=

# Firebase Admin 서비스계정 키(JSON)를 base64로 인코딩한 값.
# /api/github-import(ZIP 업로드), /api/download(구매검증+서명URL), /api/sync-toolkit 에서 사용. 서버 전용 비밀값.
FIREBASE_SERVICE_ACCOUNT_B64=

# Auto Toolkit → AutoHub 동기화(/api/sync-toolkit) 인증용 공유 시크릿.
# Auto Toolkit 저장소의 AUTOHUB_SYNC_SECRET 와 같은 값이어야 한다. 서버 전용 비밀값.
AUTOHUB_SYNC_SECRET=

# Toss Payments 정기결제.
# 클라이언트 공개 키: Toss 개발자센터의 Client Key 또는 Widget ID.
VITE_TOSS_CLIENT_KEY=
# 서버 시크릿 키: 절대 클라이언트에 노출하지 않습니다.
TOSS_SECRET_KEY=

# Optional overrides (defaults are set in code: gpt-5.4-mini / gpt-image-2 / medium)
# OPENAI_TEXT_MODEL=
# OPENAI_IMAGE_MODEL=
# OPENAI_IMAGE_QUALITY=

# 통신판매(전자상거래법) 필수 표시사항 — 약관/사업자정보 페이지 자동 렌더에 사용 (공개용, 클라이언트 노출 OK)
VITE_BIZ_COMPANY_NAME=
VITE_BIZ_SERVICE_NAME=
VITE_BIZ_CEO=
VITE_BIZ_REG_NO=
VITE_BIZ_MAILORDER_NO=
VITE_BIZ_ADDRESS=
VITE_BIZ_PHONE=
VITE_BIZ_EMAIL=
VITE_BIZ_HOST=
VITE_BIZ_COURT=
