rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 스티커 세션: 학생이 QR/코드로 참여하므로 읽기는 공개, 생성/수정은 교사(로그인)만
    match /stickerSessions/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 스티커 참여자: 학생이 로그인 없이 참여/스티커 수령하므로 공개 허용
    match /stickerParticipants/{id} {
      allow read, write: if true;
    }

    // 패들렛 세션: 학생이 QR/링크로 참여하므로 읽기는 공개, 생성/수정은 교사(로그인)만
    match /padletSessions/{id} {
      allow read: if true;
      allow write: if request.auth != null;

      // 포스트잇: 학생이 로그인 없이 작성/조회하므로 공개 허용
      match /posts/{postId} {
        allow read, write: if true;
      }
    }

    // 공개 퀴즈: 누구나 읽기 가능 (SEO, 커뮤니티)
    match /quizzes/{quizId} {
      allow read: if resource.data.isPublic == true || request.auth != null;
      allow write: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // 모든 사용자가 카탈로그 조회를 할 수 있도록 허용
    match /catalog/{productId} {
      allow read: if true;
      // 어드민 사용자만 등록/수정/삭제 가능
      allow write: if request.auth != null && (request.auth.token.admin == true || request.auth.token.email == 'duoenjia8@gmail.com');
    }

    // 구매한 라이브러리는 소유자만 조회 가능
    match /libraries/{libraryId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      // 무료(price=0) 상품만 클라이언트가 직접 추가 가능. 유료 상품은 결제 API(Admin SDK, 규칙 우회)만 생성 — 결제 우회 방지.
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && get(/databases/$(database)/documents/catalog/$(request.resource.data.productId)).data.price == 0;
      allow update, delete: if false;
    }

    // 사용자 정보: 조회는 본인만. 쓰기는 결제/쿠폰 API(Admin SDK)만 수행 — 클라이언트가 직접 pendingDiscount 등을 조작해 결제를 우회하지 못하도록 차단.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // 동기화 로그: 관리자만 조회. 쓰기는 서버(Admin SDK, 규칙 우회)만 수행하므로 클라이언트 차단.
    match /syncLogs/{syncId} {
      allow read: if request.auth != null && (request.auth.token.admin == true || request.auth.token.email == 'duoenjia8@gmail.com');
      allow write: if false;
    }

    // 기본: 인증된 사용자만 읽기/쓰기 (다른 앱들의 컬렉션 포함)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
